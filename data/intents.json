      "patterns": [
        "hello",
        "hi",
        "hey there",
        "good morning",
        "good afternoon",
        "how are you",
        "is anyone there",
        "hello chatbot",
        "hi there",
        "hey"
      ],
      "responses": [
        "Hello! How can I help you?",
        "Hi there! What would you like to know?",
        "Hey! I'm here to help."
      ]
    },
    {
      "tag": "goodbye",
      "patterns": [
        "bye",
        "goodbye",
        "see you later",
        "talk to you later",
        "have a nice day",
        "I am leaving",
        "catch you later",
        "see you soon",
        "take care",
        "good night"
      ],
      "responses": [
        "Goodbye! Have a great day.",
        "See you soon!",
        "Thanks for chatting. Take care!"
      ]
    },
    {
      "tag": "thanks",
      "patterns": [
        "thank you",
        "thanks",
        "thanks a lot",
        "I appreciate it",
        "that was helpful",
        "many thanks",
